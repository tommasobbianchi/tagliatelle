{
  "name": "tagliatelle-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TaglIAtelle web UI skeleton (lane L4): four doors, one workbench, canvas + chat + properties.",
  "scripts": {
